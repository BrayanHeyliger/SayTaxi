# Aplicación y seguridad
NODE_ENV=production
APP_URL=https://app.tu-dominio.com
ALLOWED_ORIGINS=https://app.tu-dominio.com
DATABASE_URL=mysql://USUARIO:CONTRASENA@HOST:3306/saytaxi

# Telemetría de viajes: Redis privado y con TLS en producción.
# Mantener deshabilitada hasta completar las pruebas de staging.
REDIS_URL=redis://127.0.0.1:6379
TELEMETRY_ENABLED=false
JWT_SECRET=GENERA_UN_SECRETO_DE_AL_MENOS_32_CARACTERES
SUPER_ADMIN_EMAIL=admin@tu-dominio.com
SUPER_ADMIN_PASSWORD=USA_UN_SECRETO_UNICO_DE_AL_MENOS_16_CARACTERES

# Facturación Stripe (configura ambos o deja ambos vacíos para deshabilitar pagos)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Correo transaccional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notificaciones@tu-dominio.com

# Servicios de mapas: configura un proveedor de producción antes de lanzar.
VITE_GOOGLE_MAPS_API_KEY=
