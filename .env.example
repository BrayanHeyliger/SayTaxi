# =========================================================
# WhatsApp Taxi SaaS — Variables de Entorno de Ejemplo
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# =========================================================

# ---------------------------------------------------------
# Base de Datos (MySQL)
# ---------------------------------------------------------
DATABASE_URL=mysql://usuario:contraseña@localhost:3306/whatsapp_taxi

# ---------------------------------------------------------
# Autenticación — JWT
# Genera con: openssl rand -base64 32
# ---------------------------------------------------------
JWT_SECRET=reemplaza_con_clave_aleatoria_minimo_32_caracteres

# ---------------------------------------------------------
# Aplicación
# ---------------------------------------------------------
NODE_ENV=development
PORT=3000
# URL pública de la app (usada para CORS y URLs de retorno en Stripe)
APP_URL=http://localhost:3000

# ---------------------------------------------------------
# Stripe (Pagos)
# Obtén en: https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_REEMPLAZA
STRIPE_PUBLISHABLE_KEY=pk_test_REEMPLAZA
# Obtén en: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZA

# ---------------------------------------------------------
# PayPal (Pagos) — opcional
# Obtén en: https://developer.paypal.com
# ---------------------------------------------------------
PAYPAL_CLIENT_ID=REEMPLAZA
PAYPAL_CLIENT_SECRET=REEMPLAZA
PAYPAL_MODE=sandbox

# ---------------------------------------------------------
# Google Maps — opcional (si usas PlacesAutocomplete)
# Obtén en: https://console.cloud.google.com
# ---------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=REEMPLAZA

# ---------------------------------------------------------
# Email SMTP — opcional (notificaciones)
# ---------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=contraseña_de_aplicacion

# ---------------------------------------------------------
# AWS S3 — opcional (almacenamiento de archivos)
# ---------------------------------------------------------
AWS_ACCESS_KEY_ID=REEMPLAZA
AWS_SECRET_ACCESS_KEY=REEMPLAZA
AWS_REGION=us-east-1
AWS_S3_BUCKET=nombre-del-bucket

# ---------------------------------------------------------
# OAuth / Manus (interno — no modificar en producción propia)
# ---------------------------------------------------------
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
